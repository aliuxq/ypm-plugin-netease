{
  "id": "netease",
  "name": "网易云音乐",
  "version": "1.1.0",
  "author": "aliuxq",
  "description": "网易云音乐音乐源：扫码登录，浏览歌单、每日推荐、私人 FM 与排行榜，播放你的红心歌曲和收藏专辑。非官方插件，仅请求网易云自己的接口，不提供解锁或下载。",
  "minAppVersion": "3.0.0",
  "main": "index.js",
  "icon": "icon.png",
  "playback": "stream",
  "permissions": {
    "network": ["interface.music.163.com"]
  },
  "settings": [
    {
      "key": "quality",
      "label": "音质",
      "type": "select",
      "help": "优先使用所选音质，不可用时自动降级；「跟随播放器」使用播放器请求的档位。",
      "options": [
        { "value": "", "label": "跟随播放器" },
        { "value": "standard", "label": "标准" },
        { "value": "high", "label": "高音质" },
        { "value": "lossless", "label": "无损" },
        { "value": "hires", "label": "Hi-Res" }
      ]
    },
    {
      "key": "cookie",
      "label": "Cookie（可选）",
      "type": "password",
      "help": "扫码登录被风控拦截时使用：在浏览器登录 music.163.com，把 Cookie 里 MUSIC_U 的值（或整段 Cookie）粘贴到这里，再点一次登录。填了就优先使用它。",
      "link": "https://music.163.com/"
    }
  ],
  "navigation": [
    { "builtin": "home" },
    { "builtin": "liked" },
    { "builtin": "savedAlbums" },
    { "title": "我的云盘", "page": "cloud" },
    { "title": "排行榜", "page": "charts" }
  ]
}
